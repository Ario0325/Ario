      "parameters": {
        "jsCode": "\nconst raw = $input.item.json;\nconst body = raw.body ?? raw;\nconst items = body.items || [];\n\nfunction formatPrice(price) {\n  return new Intl.NumberFormat('fa-IR').format(price) + ' تومان';\n}\n\nconst itemRows = items.map((item, index) => `\n  <tr style=\"background: ${index % 2 === 0 ? '#f9f9f9' : '#ffffff'};\">\n    <td style=\"padding:12px 16px;border-bottom:1px solid #e0e0e0;text-align:right;\">${item.name}</td>\n    <td style=\"padding:12px 16px;border-bottom:1px solid #e0e0e0;text-align:center;\">${item.quantity}</td>\n    <td style=\"padding:12px 16px;border-bottom:1px solid #e0e0e0;text-align:center;\">${formatPrice(item.unit_price)}</td>\n    <td style=\"padding:12px 16px;border-bottom:1px solid #e0e0e0;text-align:center;font-weight:bold;color:#2e7d32;\">${formatPrice(item.total_price)}</td>\n  </tr>\n`).join('');\n\nconst orderDate = new Date(body.created_at).toLocaleDateString('fa-IR', {\n  year: 'numeric', month: 'long', day: 'numeric'\n});\n\nconst grandTotal = (body.total_price || 0) + (body.shipping_cost || 0) - (body.discount || 0);\n\nconst html = `<!DOCTYPE html>\n<html dir=\"rtl\" lang=\"fa\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>تایید سفارش - آریو شاپ</title>\n<style>\n*{margin:0;padding:0;box-sizing:border-box}\nbody{font-family:Tahoma,Arial,sans-serif;background:#f0f4f8;direction:rtl;color:#333}\n.container{max-width:650px;margin:30px auto;background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,.12)}\n.header{background:linear-gradient(135deg,#1a237e,#283593,#3949ab);padding:40px 30px;text-align:center}\n.header h1{color:#fff;font-size:26px;font-weight:700;margin-bottom:8px}\n.header p{color:rgba(255,255,255,.85);font-size:14px}\n.badge{display:inline-block;background:#4caf50;color:#fff;border-radius:50px;padding:8px 24px;font-size:14px;margin:16px 0}\n.body{padding:32px 30px}\n.greeting{font-size:18px;font-weight:700;margin-bottom:8px;color:#1a237e}\n.message{font-size:14px;color:#555;line-height:1.8;margin-bottom:28px}\n.section-title{font-size:15px;font-weight:700;color:#333;margin-bottom:12px;padding-bottom:8px;border-bottom:2px solid #e8eaf6}\n.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:28px}\n.info-box{background:#f5f5f5;border-radius:10px;padding:14px 16px}\n.info-box .label{font-size:11px;color:#888;margin-bottom:4px}\n.info-box .value{font-size:14px;font-weight:700;color:#222}\ntable{width:100%;border-collapse:collapse;margin-bottom:20px;border:1px solid #e0e0e0}\nthead{background:#1a237e;color:#fff}\nthead th{padding:12px 16px;text-align:right;font-size:13px;font-weight:700}\n.summary-box{background:#e8eaf6;border-radius:10px;padding:20px;margin-bottom:28px}\n.summary-row{display:flex;justify-content:space-between;align-items:center;padding:6px 0;font-size:14px}\n.summary-row.total{border-top:2px solid #3949ab;margin-top:10px;padding-top:14px;font-size:17px;font-weight:700;color:#1a237e}\n.address-box{background:#f9fbe7;border:1px solid #c5e1a5;border-radius:10px;padding:16px;margin-bottom:28px;font-size:14px;line-height:1.7}\n.footer{background:#1a237e;padding:24px;text-align:center}\n.footer p{color:rgba(255,255,255,.7);font-size:12px;line-height:1.8}\n</style>\n</head>\n<body>\n<div class=\"container\">\n  <div class=\"header\">\n    <h1>🛍️ آریو شاپ</h1>\n    <p>فروشگاه آنلاین</p>\n    <div class=\"badge\">✅ سفارش با موفقیت ثبت شد</div>\n  </div>\n  <div class=\"body\">\n    <p class=\"greeting\">سلام ${body.customer_name} عزیز،</p>\n    <p class=\"message\">از خرید شما سپاسگزاریم! پرداخت شما با موفقیت انجام شد و سفارش شما در حال پردازش است.</p>\n    <p class=\"section-title\">📋 اطلاعات سفارش</p>\n    <div class=\"info-grid\">\n      <div class=\"info-box\"><div class=\"label\">شماره سفارش</div><div class=\"value\">${body.order_number}</div></div>\n      <div class=\"info-box\"><div class=\"label\">تاریخ سفارش</div><div class=\"value\">${orderDate}</div></div>\n      <div class=\"info-box\"><div class=\"label\">وضعیت پرداخت</div><div class=\"value\" style=\"color:#2e7d32\">✅ پرداخت موفق</div></div>\n      <div class=\"info-box\"><div class=\"label\">ایمیل</div><div class=\"value\" style=\"direction:ltr;text-align:left;\">${body.customer_email}</div></div>\n    </div>\n    <p class=\"section-title\">🛒 اقلام سفارش</p>\n    <table>\n      <thead><tr><th>نام محصول</th><th style=\"text-align:center\">تعداد</th><th style=\"text-align:center\">قیمت واحد</th><th style=\"text-align:center\">قیمت کل</th></tr></thead>\n      <tbody>${itemRows}</tbody>\n    </table>\n    <div class=\"summary-box\">\n      <div class=\"summary-row\"><span>جمع کالاها:</span><span>${formatPrice(body.total_price || 0)}</span></div>\n      <div class=\"summary-row\"><span>هزینه ارسال:</span><span>${body.shipping_cost > 0 ? formatPrice(body.shipping_cost) : 'رایگان'}</span></div>\n      ${body.discount > 0 ? '<div class=\"summary-row\" style=\"color:#c62828\"><span>تخفیف:</span><span>-' + formatPrice(body.discount) + '</span></div>' : ''}\n      <div class=\"summary-row total\"><span>💰 مبلغ نهایی:</span><span>${formatPrice(grandTotal)}</span></div>\n    </div>\n    ${body.shipping_address ? '<p class=\"section-title\">📍 آدرس ارسال</p><div class=\"address-box\">' + body.shipping_address + '</div>' : ''}\n    <p style=\"font-size:13px;color:#777;text-align:center;\">در صورت هرگونه سوال با پشتیبانی ما تماس بگیرید.</p>\n  </div>\n  <div class=\"footer\">\n    <p>آریو شاپ | فروشگاه آنلاین<br>این ایمیل به صورت خودکار ارسال شده است.</p>\n  </div>\n</div>\n</body>\n</html>`;\n\nreturn [{ json: { ...body, emailHtml: html, grandTotal, orderDate } }];\n      "
      },

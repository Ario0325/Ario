        "jsCode": "const body = $json.body ?? $json;\nconst items = body.items ?? [];\nconst itemsList = items.map((item, idx) =>\n  `  ${idx + 1}. ${item.name}\\n     تعداد: ${item.quantity} | قیمت واحد: ${Number(item.unit_price).toLocaleString('fa-IR')} تومان | جمع: ${Number(item.total_price).toLocaleString('fa-IR')} تومان`\n).join('\\n');\nconst message = `🛍️ <b>سفارش جدید ثبت شد!</b>\\n\\n📋 <b>شماره سفارش:</b> ${body.order_number}\\n🆔 <b>آیدی سفارش:</b> #${body.order_id}\\n\\n👤 <b>اطلاعات مشتری:</b>\\n  نام: ${body.customer_name}\\n  ایمیل: ${body.customer_email}\\n  تلفن: ${body.customer_phone}\\n\\n📦 <b>آیتم‌های سفارش:</b>\\n${itemsList}\\n\\n💰 <b>جزئیات مالی:</b>\\n  هزینه ارسال: ${Number(body.shipping_cost ?? 0).toLocaleString('fa-IR')} تومان\\n  تخفیف: ${Number(body.discount ?? 0).toLocaleString('fa-IR')} تومان\\n  <b>مجموع کل: ${Number(body.total_price).toLocaleString('fa-IR')} تومان</b>\\n\\n💳 <b>روش پرداخت:</b> ${body.payment_method}\\n📍 <b>آدرس:</b> ${body.shipping_address}\\n✅ <b>وضعیت:</b> ${body.status === 'paid' ? 'پرداخت شده ✅' : body.status}\\n⏰ <b>زمان ثبت:</b> ${body.created_at}`;\nreturn { json: { message, order_id: body.order_id } };"
      },

# Development environment variables
# Set DEBUG=True for local development, False for production

DEBUG=True
DJANGO_SECRET_KEY=dev-secret-key-for-local-development-only
ALLOWED_HOSTS=localhost,127.0.0.1

# Email (production only)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# N8N Webhook (online - n8n.cloud)
# Set these after creating workflows in n8n.cloud
# N8N_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/django-auth-event
# N8N_WEBHOOK_SECRET=ario-shop-secret-token

# N8N Order Confirmation Webhook
# N8N_ORDER_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/order-paid
# N8N_ORDER_WEBHOOK_SECRET=ario-shop-secret-token

# N8N Sender Email
# N8N_SENDER_EMAIL=bardiaabdi1393@gmail.com
